# Local Worker preview (`npm run preview`). Copy to .dev.vars (git-ignored).
BETTER_AUTH_URL=http://localhost:8787
# Random secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
# Optional: Google sign-in (see docs/DEPLOY.md). Leave out to disable.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email and password sign-in. The deployed Worker sets "off" (wrangler.jsonc); keep "on" locally
# so the smoke test can sign up.
EMAIL_PASSWORD_LOGIN=on
