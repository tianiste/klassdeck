# Public URL of the app (used for OAuth issuer and the MCP resource URL)
BETTER_AUTH_URL=http://localhost:3000
# Random secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
# Postgres connection string. Leave unset locally: `npm run dev` starts a
# local Postgres in ./.data and sets it for you.
# DATABASE_URL=
# Optional: connection pool size (default 10)
# DATABASE_POOL_MAX=
# Optional: Google sign-in. Leave unset to use email and password only.
# Create the OAuth client in Google Cloud Console (see docs/DEPLOY.md).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
