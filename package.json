{
  "name": "klassdeck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "auth generate --config auth.gen.ts --output src/db/auth-schema.ts --yes",
    "smoke": "node scripts/smoke-mcp.mjs"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.28",
    "@better-auth/mcp": "1.7.28",
    "@better-auth/oauth-provider": "1.7.28",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-auth": "1.7.28",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.28",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.12.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@17.12.0-beta.19": true
  }
}
