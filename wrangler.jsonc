{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klassdeck",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference the adapter uses for internal requests; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "klassdeck"
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    // Google-only sign-in in production for now: password hashing needs ~40 ms of CPU and
    // the Workers free plan allows 10 ms per request. .dev.vars sets "on" for local preview.
    "EMAIL_PASSWORD_LOGIN": "off"
  },
  // Secrets (BETTER_AUTH_SECRET, BETTER_AUTH_URL) are set with `wrangler secret put`,
  // and locally in .dev.vars. See docs/DEPLOY.md.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // klassdeck-db: Neon direct connection, query caching disabled (see docs/DEPLOY.md).
      "id": "6b3b71f01d584d3d84976b9be172d895",
      // Used only by `npm run preview`; overridden by
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5433/klassdeck"
    }
  ]
}
